# Copie pra .env (não vai pro git) e preencha.
# Mesmo token nas duas máquinas. Gere um com: openssl rand -hex 24
AGENT_TOKEN=
# Só no Orange Pi: IP do Servidor no Tailscale + porta do agente.
SERVIDOR_AGENT_URL=http://100.x.y.z:3002
# Só no Orange Pi: hash da senha do login do menu (a senha dá acesso ao
# terminal das duas máquinas — use uma forte). Não preencha à mão: rode
# ./definir-senha.sh, que pede a senha e grava só o hash aqui.
ADMIN_PASSWORD_HASH=
# Só no Orange Pi: chave do 2FA (código do app autenticador no login).
# Gere com: node server/totp.js
#   (ou, com o menu já rodando: docker compose exec rincon-menu-checker node totp.js)
ADMIN_TOTP_SECRET=
# Opcional, nas duas: usuário do terminal (vazio = root). Ex.: orangepi
TERMINAL_USER=
